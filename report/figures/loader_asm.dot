digraph loader_asm {
    graph [bgcolor="white", rankdir=TB, splines=ortho, pad=0.25, nodesep=0.45, ranksep=0.5];
    node [fontname="Helvetica", fontsize=11, margin="0.14,0.09"];
    edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
    idle [shape=box, label=<<B>IDLE (0)</B>>];
    cap [shape=box, label=<<B>CAPTURE (1)</B><BR/>row[sel_q][5:2] &lt;= ibuf_rd_data<BR ALIGN="LEFT"/>>];
    req0 [shape=diamond, label=<<B>load_en?</B>>];
    req1 [shape=diamond, label=<<B>load_en?</B>>];
    init [shape=diamond, label=<<B>init_q?</B>>];
    bottom [shape=diamond, label=<<B>sel_q == 2?</B>>];
    last [shape=diamond, label=<<B>base == BASE_LAST?</B>>];
    zero [shape=box, label=<<B>row[sel_q][1:0] &lt;= 0</B>>];
    carry [shape=box, label=<<B>row[sel_q][1:0] &lt;= row[sel_q][5:4]</B>>];
    wrap [shape=box, label=<<B>base &lt;= 0</B>>];
    inc [shape=box, label=<<B>base &lt;= base + 1</B>>];
    idle -> req0;
    req0 -> idle [xlabel="load_en = 0", constraint=false];
    req0 -> cap [xlabel="load_en = 1"];
    cap -> init;
    init -> zero [xlabel="init_q = 1"];
    init -> carry [xlabel="init_q = 0"];
    zero -> bottom;
    carry -> bottom;
    bottom -> last [xlabel="1"];
    bottom -> req1 [xlabel="0"];
    last -> wrap [xlabel="1"];
    last -> inc [xlabel="0"];
    wrap -> req1;
    inc -> req1;
    req1 -> cap [xlabel="load_en = 1", constraint=false];
    req1 -> idle [xlabel="load_en = 0", constraint=false];
    subgraph cluster_idle {
        graph [style=dashed, color="#666666", penwidth=1, margin=18, label=""];
        idle; req0;
    }
    subgraph cluster_capture {
        graph [style=dashed, color="#666666", penwidth=1, margin=18, label=""];
        cap; init; zero; carry; bottom; last; wrap; inc; req1;
    }
}
