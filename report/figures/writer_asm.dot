digraph writer_asm {
    graph [bgcolor="white", rankdir=TB, splines=ortho, pad=0.25, nodesep=0.45, ranksep=0.5];
    node [fontname="Helvetica", fontsize=11, margin="0.14,0.09"];
    edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
    s0 [shape=box, label=<<B>IDLE (0)</B>>];
    s1 [shape=box, label=<<B>STORE_2 (1)</B><BR/>carry &lt;= {p3, p2, 8&#x27;b0}<BR ALIGN="LEFT"/>>];
    s2 [shape=box, label=<<B>STORE_4 (2)</B><BR/>wr_en = 1; wr_data = {p0, carry}<BR ALIGN="LEFT"/>carry &lt;= {p3, p2, p1}<BR ALIGN="LEFT"/>wa &lt;= (wa == WA_LAST) ? WA_FIRST : wa + 1<BR ALIGN="LEFT"/>>];
    s3 [shape=box, label=<<B>FLUSH (3)</B><BR/>wr_en = 1; wr_data = {8&#x27;b0, carry}<BR ALIGN="LEFT"/>wa &lt;= (wa == WA_LAST) ? WA_FIRST : wa + 1<BR ALIGN="LEFT"/>>];
    first [shape=diamond, label=<<B>first?</B>>];
    write [shape=diamond, label=<<B>write?</B>>];
    flush [shape=diamond, label=<<B>flush?</B>>];
    s0 -> first;
    first -> s1 [xlabel="first = 1"];
    first -> write [xlabel="first = 0"];
    write -> s2 [xlabel="write = 1"];
    write -> s0 [xlabel="write = 0", constraint=false];
    s1 -> s0 [constraint=false];
    s2 -> flush;
    flush -> s3 [xlabel="flush = 1"];
    flush -> s0 [xlabel="flush = 0", constraint=false];
    s3 -> s0 [constraint=false];
    subgraph cluster_idle {
        graph [style=dashed, color="#666666", penwidth=1, margin=18, label=""];
        s0; first; write;
    }
    subgraph cluster_store_2 {
        graph [style=dashed, color="#666666", penwidth=1, margin=18, label=""];
        s1;
    }
    subgraph cluster_store_4 {
        graph [style=dashed, color="#666666", penwidth=1, margin=18, label=""];
        s2; flush;
    }
    subgraph cluster_flush {
        graph [style=dashed, color="#666666", penwidth=1, margin=18, label=""];
        s3;
    }
}
