digraph loader_fsm {
    graph [bgcolor="white", rankdir=TB, pad=0.25, nodesep=0.45, ranksep=0.5];
    node [fontname="Helvetica", fontsize=11, margin="0.14,0.09"];
    edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
    idle [shape=box, label=<<B>IDLE (0)</B>>];
    cap [shape=box, label=<<B>CAPTURE (1)</B><BR/>row[sel_q][5:2] &lt;= ibuf_rd_data<BR ALIGN="LEFT"/>row[sel_q][1:0] &lt;= init_q ? 0 : row[sel_q][5:4]<BR ALIGN="LEFT"/>if sel_q == 2: base &lt;= (base == BASE_LAST) ? 0 : base + 1<BR ALIGN="LEFT"/>>];
    idle -> idle [label="load_en = 0"];
    idle -> cap [label="load_en = 1"];
    cap -> cap [label="load_en = 1"];
    cap -> idle [label="load_en = 0"];
}
