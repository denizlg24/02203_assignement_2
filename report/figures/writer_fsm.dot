digraph writer_fsm {
    graph [bgcolor="white", rankdir=TB, pad=0.25, nodesep=0.45, ranksep=0.5];
    node [fontname="Helvetica", fontsize=11, margin="0.14,0.09"];
    edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
    s0 [shape=box, label=<<B>IDLE (0)</B>>];
    s1 [shape=box, label=<<B>STORE_2 (1)</B><BR/>carry &lt;= {p3, p2, 8&#x27;b0}<BR ALIGN="LEFT"/>>];
    s2 [shape=box, label=<<B>STORE_4 (2)</B><BR/>wr_en = 1; wr_data = {p0, carry}<BR ALIGN="LEFT"/>carry &lt;= {p3, p2, p1}<BR ALIGN="LEFT"/>>];
    s3 [shape=box, label=<<B>FLUSH (3)</B><BR/>wr_en = 1; wr_data = {8&#x27;b0, carry}<BR ALIGN="LEFT"/>>];
    s0 -> s0 [label="first = 0 && write = 0"];
    s0 -> s1 [label="first = 1"];
    s0 -> s2 [label="first = 0 && write = 1"];
    s1 -> s0;
    s2 -> s3 [label="flush = 1"];
    s2 -> s0 [label="flush = 0"];
    s3 -> s0;
}
