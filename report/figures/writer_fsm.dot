digraph writer_fsm {
    graph [bgcolor="white", splines=true, outputorder=nodesfirst, pad=0.2];
    node [shape=circle, fixedsize=true, width=2.000, fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];

    // Moore outputs (=) and register transfers (<=) below the divider
    s0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><B>0: idle</B></TD></TR><HR/><TR><TD>wr_en = 0</TD></TR></TABLE>>, pos="0.0,562.0"];
    s1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><B>1: store_2</B></TD></TR><HR/><TR><TD>carry &lt;=<BR/>{p3, p2, 0}</TD></TR></TABLE>>, pos="-420.0,192.0"];
    s2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><B>2: store_4</B></TD></TR><HR/><TR><TD>wr_en = 1<BR/>wr_data = {p0, carry}<BR/>carry &lt;= {p3, p2, p1}<BR/>wa &lt;= wa + 1</TD></TR></TABLE>>, pos="-140.0,192.0"];
    s3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><B>3: flush</B></TD></TR><HR/><TR><TD>wr_en = 1<BR/>wr_data = {0, carry}<BR/>wa &lt;= wa + 1</TD></TR></TABLE>>, pos="140.0,192.0"];
    s4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><B>4: zero</B></TD></TR><HR/><TR><TD>wr_en = 1<BR/>wr_data = 0<BR/>wa &lt;= wa + 1</TD></TR></TABLE>>, pos="420.0,192.0"];
    note0 [shape=box, fixedsize=false, style=dashed, fontsize=10, fontname="Courier", margin="0.15,0.1", label="obuf_wr_en   = wr_en\lobuf_wr_addr = wa      (wraps 25343 -> 0)\lobuf_wr_data = wr_data\lp_i = pixel_i from sobel_i\l\lstore_4 -> flush only on the last batch\lof a row; flush -> zero only after row 286.\lzero runs for exactly the 88 cycles\lzero_row is held by the controller.\l", pos="-450.0,562.0"];

    s0 -> s0 [pos="e,27.0,628.8 -27.0,628.8 -83.2,686.2 74.7,688.0 31.7,634.1", label="no command", lp="0.0,682.2"];
