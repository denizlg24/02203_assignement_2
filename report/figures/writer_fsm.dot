    s2 -> s0 [pos="e,-15.9,491.8 -105.4,255.1 -105.4,255.1 -18.4,485.2 -18.4,485.2", label="flush = 0", lp="-29.0,383.9"];
    s0 -> s4 [pos="e,359.9,231.6 46.9,507.4 46.9,507.4 354.6,236.3 354.6,236.3", label="zero_row = 1", lp="232.1,305.3"];
    s4 -> s0 [pos="e,60.1,522.4 373.1,246.6 373.1,246.6 65.4,517.7 65.4,517.7", label="zero_row = 0", lp="250.5,393.5"];
    s3 -> s0 [pos="e,25.5,494.7 114.5,259.3 114.5,259.3 28.0,488.1 28.0,488.1", label="zero_row = 0", lp="48.4,340.3"];
    s2 -> s3 [pos="e,68.0,192.0 -68.0,192.0 -68.0,192.0 61.0,192.0 61.0,192.0", label="flush = 1", lp="0.0,202.0"];
    s3 -> s4 [pos="e,348.0,192.0 212.0,192.0 212.0,192.0 341.0,192.0 341.0,192.0", label="zero_row = 1", lp="280.0,202.0"];
    s4 -> s4 [pos="e,393.0,125.2 447.0,125.2 503.2,67.8 345.3,66.0 388.3,119.9", label="zero_row = 1", lp="420.0,71.8"];
