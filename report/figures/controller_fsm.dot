digraph controller_fsm {
    graph [bgcolor="white", rankdir=TB, pad=0.25, nodesep=0.45, ranksep=0.5];
    node [fontname="Helvetica", fontsize=11, margin="0.14,0.09"];
    edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
    s0 [shape=box, label=<<B>IDLE (0)</B><BR/>r &lt;= 0; k &lt;= 0<BR ALIGN="LEFT"/>>];
    s1 [shape=box, label=<<B>LOAD_1 (1)</B><BR/>load_en = 1; row_sel = 0<BR ALIGN="LEFT"/>init = (k == 0)<BR ALIGN="LEFT"/>>];
    s2 [shape=box, label=<<B>LOAD_2 (2)</B><BR/>load_en = 1; row_sel = 1<BR ALIGN="LEFT"/>init = (k == 0)<BR ALIGN="LEFT"/>>];
    s3 [shape=box, label=<<B>LOAD_3 (3)</B><BR/>load_en = 1; row_sel = 2<BR ALIGN="LEFT"/>init = (k == 0)<BR ALIGN="LEFT"/>>];
    s4 [shape=box, label=<<B>_WAIT (4)</B>>];
    s5 [shape=box, label=<<B>COMP_2 (5)</B><BR/>first = 1; k &lt;= k + 1<BR ALIGN="LEFT"/>>];
    s6 [shape=box, label=<<B>COMP_4 (6)</B><BR/>write = 1; k &lt;= k + 1<BR ALIGN="LEFT"/>>];
    s7 [shape=box, label=<<B>NEXT_ROW (7)</B><BR/>flush = 1; k &lt;= 0; r &lt;= r + 1<BR ALIGN="LEFT"/>>];
    s8 [shape=box, label=<<B>DONE (8)</B><BR/>finish = 1<BR ALIGN="LEFT"/>>];
    reset [shape=plaintext, label=<<B>rst_n = 0</B>>];
    reset -> s0;
    s0 -> s0 [label="start = 0"];
    s0 -> s1 [label="start = 1"];
    s1 -> s2;
    s2 -> s3;
    s3 -> s4;
    s4 -> s5 [label="k == 0"];
    s4 -> s6 [label="k != 0"];
    s5 -> s1;
    s6 -> s7 [label="k == W-1"];
    s6 -> s1 [label="k != W-1"];
    s7 -> s8 [label="r == H-3"];
    s7 -> s1 [label="r != H-3"];
    s8 -> s0;
}
