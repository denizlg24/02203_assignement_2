digraph controller_asm {
    graph [
        bgcolor="white",
        splines=true,
        outputorder=nodesfirst,
        pad=0.2,
        rankdir=TB,
        nodesep=0.45,
        ranksep=0.55
    ];

    node [
        fontname="Helvetica",
        fontsize=11,
        fixedsize=false
    ];

    edge [
        fontname="Helvetica",
        fontsize=10,
        arrowsize=0.7
    ];

    // ASM state boxes
    s0 [
        shape=rect,
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
            <TR><TD><B>IDLE (0)</B></TD></TR>
            <HR/>
            <TR><TD>r &lt;= 0</TD></TR>
            <TR><TD>k &lt;= 0</TD></TR>
        </TABLE>>
    ];

    s1 [
        shape=rect,
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
            <TR><TD><B>LOAD_1 (2)</B></TD></TR>
            <HR/>
            <TR><TD>load_en = 1</TD></TR>
            <TR><TD>row_sel = 0</TD></TR>
            <TR><TD>init = (k == 0)</TD></TR>
        </TABLE>>
    ];

    s2 [
        shape=rect,
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
            <TR><TD><B>LOAD_2 (2)</B></TD></TR>
            <HR/>
            <TR><TD>row_sel = 1</TD></TR>
        </TABLE>>
    ];

    s3 [
        shape=rect,
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
            <TR><TD><B>LOAD_3 (2)</B></TD></TR>
            <HR/>
            <TR><TD>row_sel = 2</TD></TR>
        </TABLE>>
    ];

    s4 [
        shape=rect,
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
            <TR><TD><B>WAIT (3)</B></TD></TR>
            <HR/>
            <TR><TD>load_en = 0</TD></TR>
        </TABLE>>
    ];

    s5 [
        shape=rect,
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
            <TR><TD><B>COMP_2 (4)</B></TD></TR>
            <HR/>
            <TR><TD>first = 1</TD></TR>
            <TR><TD>k &lt;= k + 1</TD></TR>
        </TABLE>>
    ];

    s6 [
        shape=rect,
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
            <TR><TD><B>COMP_4 (5)</B></TD></TR>
            <HR/>
            <TR><TD>write = 1</TD></TR>
            <TR><TD>k &lt;= k + 1</TD></TR>
        </TABLE>>
    ];

    s7 [
        shape=rect,
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
            <TR><TD><B>NEXT_ROW (6)</B></TD></TR>
            <HR/>
            <TR><TD>flush = 1</TD></TR>
            <TR><TD>r &lt;= r + 1</TD></TR>
            <TR><TD>k &lt;= 0</TD></TR>
        </TABLE>>
    ];

    s8 [
        shape=rect,
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
            <TR><TD><B>DONE (8)</B></TD></TR>
            <HR/>
            <TR><TD>finish = 1</TD></TR>
        </TABLE>>
    ];

    // ASM decision boxes
    d0 [shape=diamond, label="start"];
    d1 [shape=diamond, label="k == 0"];
    d2 [shape=diamond, label="k == 87"];
    d3 [shape=diamond, label="r == 286"];

    // State transitions and decisions
    s0 -> d0;
    d0 -> s0 [label="0"];
    d0 -> s1 [label="1"];

    s1 -> s2;
    s2 -> s3;
    s3 -> s4;

    s4 -> d1;
    d1 -> s5 [label="1"];
    d1 -> s6 [label="0"];

    s5 -> s1;

    s6 -> d2;
    d2 -> s7 [label="1"];
    d2 -> s1 [label="0"];

    s7 -> d3;
    d3 -> s8 [label="1"];
    d3 -> s1 [label="0"];

    s8 -> s0;
}
